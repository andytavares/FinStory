{
  "name": "money",
  "version": "0.1.0",
  "description": "Automated spend tracking and awareness — a local-first personal finance desktop application",
  "main": "./out/main/index.js",
  "author": "Andrew",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@napi-rs/keyring": "2.1.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "cron": "4.4.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "electron-updater": "6.8.10",
    "lucide-react": "1.37.0",
    "ofx-js": "1.1.2",
    "plaid": "46.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller": false
  }
}
